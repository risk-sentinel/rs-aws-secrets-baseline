vendor/
*.lock
hdf.json
exec-*.json

# ---- Local scan / evidence artifacts ----------------------------------------
# An HDF or scanner output can contain REAL findings — for a secrets scanner,
# the secret itself. Committing one by accident would publish the very thing the
# scan exists to catch.
*.hdf.json
trufflehog.json
/out/
# The README's evidence pipeline writes these by name. Results for this profile
# carry secret ARNs (which embed the account id), so they must never be
# committed by a copy-paste of the quickstart.
results.json
results.*.json
*.v3.json
# saf-cli drops this beside whatever it is run against.
saf-cli.log
# staged by the CI evidence pipeline before the scan runs.
audit.pre.json
results-hdfv2.json

# Artifacts the evidence pipeline and its quickstart create. Scan output
# can contain the very thing a scan exists to find, so none of it is
# committed by a copy-paste of the README.
results-heimdall.json
results.normalized.json
